# 复制本文件为 .env.development / .env.production / .env.staging 后按环境修改

# 浏览器标签页标题
VUE_APP_TITLE = 考试审批与毕业达成度系统

# 接口前缀（需与 vue.config.js 代理或网关路径一致）
VUE_APP_BASE_API = /dev-api

# 可选：顶部导航「源码」「文档」外链；不配置则不显示对应图标
# VUE_APP_PROJECT_REPO = https://github.com/your-org/your-repo
# VUE_APP_PROJECT_DOC = https://your-docs-site.example.com